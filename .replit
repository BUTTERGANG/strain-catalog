modules = ["python-3.12", "web"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "postgresql", "rustc", "sqlite"]

[workflow]
name = "WEED"
mode = "parallel"

[[workflow.tasks]]
id = "install"
name = "Install dependencies"
command = "pip install -r requirements.txt"
mode = "serial"

[[workflow.tasks]]
id = "start"
name = "Start application"
dependsOn = ["install"]
command = "uvicorn backend.main:app --host 0.0.0.0 --port $PORT"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn backend.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
